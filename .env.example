# Copy into Portainer's stack "Environment variables" (or a .env next to docker-compose.yml).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

PUBLIC_BASE_URL=https://media.example.com
ADMIN_API_KEY=
TOOL_API_KEY=
SIGNING_SECRET=

OLLAMA_URL=http://192.168.1.10:11434
VISION_MODEL=qwen3-vl:27b
EMBED_MODEL=nomic-embed-text

# Hybrid score threshold below which nothing is sent (tune with the "Test search" box).
MIN_SCORE=0.35
# Minimum user turns between spontaneous sends (per-library override in the UI).
DEFAULT_COOLDOWN_TURNS=4

# Optional: toy control through Intiface Central on the PC you chat from (see README "Toy control").
# INTIFACE_URL=ws://10.10.10.174:12345
# TOY_MAX_DURATION_S=180    # hard cap per call; the server stops the toy by itself after this
# TOY_MAX_INTENSITY=1.0     # 0..1 ceiling on every command

# Optional
# OLLAMA_KEEP_ALIVE=5m      # how long Ollama keeps the tagger model loaded after a job
# KEYFRAMES=4               # frames sampled per video for tagging
# EMBED_DOC_PREFIX= / EMBED_QUERY_PREFIX=   # override auto-detected embedding prefixes
